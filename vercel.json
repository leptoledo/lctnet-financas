{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/apps/app/dist/index.html"
    },
    {
      "source": "/app/",
      "destination": "/apps/app/dist/index.html"
    },
    {
      "source": "/app/:match*",
      "destination": "/apps/app/dist/:match*"
    },
    {
      "source": "/hub",
      "destination": "/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/apps/landing/public/:match*"
    }
  ],
  "headers": [
    {
      "source": "/app/:match*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
