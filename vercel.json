{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/apps/app/public/index.html"
    },
    {
      "source": "/app/",
      "destination": "/apps/app/public/index.html"
    },
    {
      "source": "/app/:match*",
      "destination": "/apps/app/public/:match*"
    },
    {
      "source": "/hub",
      "destination": "/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/apps/landing/public/:match*"
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
