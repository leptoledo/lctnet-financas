{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/assets/:match*",
      "destination": "/app/assets/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "/app/assets/:match*"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/((?!assets/|.*\\.[\\w]+$).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
